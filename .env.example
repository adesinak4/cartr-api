# Application
NODE_ENV=development
PORT=3000

# Database — PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/cartr

# Redis — refresh-token / access-token denylist
REDIS_URL=redis://host:6379

# JWT — generate real random 32+ char secrets for anything beyond local dev
# e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Flutterwave — sandbox/test keys from your Flutterwave dashboard
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The "secret hash" you set under Settings > Webhooks in the Flutterwave dashboard —
# echoed back verbatim on every webhook call for verification.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# How long (minutes) a checkout holds reserved stock before it's released back
# to inventory by the scheduled expiry task. Default 30 if unset.
ORDER_RESERVATION_TIMEOUT_MINUTES=30

# Subscription billing — free trial length, renewal-failure dunning schedule,
# and the total grace period before a non-paying store is cut off. Defaults
# match what's documented in README.md.
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
SUBSCRIPTION_RENEWAL_RETRY_INTERVAL_DAYS=2

# How long the background cron keeps auto-retrying an unverified custom
# domain before giving up (an on-demand check always still works past this).
CUSTOM_DOMAIN_VERIFICATION_TIMEOUT_DAYS=7

# Google OAuth client ID — verifies ID tokens from the frontend's "Continue
# with Google" button (onboarding wizard + login). Leave unset to disable
# Google sign-in entirely (a clear SERVICE_UNAVAILABLE, not a crash).
GOOGLE_CLIENT_ID=

# Used only by `pnpm seed:admin` to create the first platform admin account
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Used only by `pnpm seed:merchant` — dev-only, creates a real merchant +
# owner login for local frontend development (no signup flow exists yet)
MERCHANT_SEED_EMAIL=
MERCHANT_SEED_PASSWORD=
MERCHANT_SEED_SLUG=
MERCHANT_SEED_STORE_NAME=
